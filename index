const $=id=>document.getElementById(id);
const n=id=>parseFloat($(id).value)||0;
const pct=id=>n(id)/100;
const touched=new Set();

const cr=x=>(x==null||!isFinite(x))?"—":"₹ "+x.toLocaleString("en-IN",{maximumFractionDigits:1,minimumFractionDigits:1})+" Cr";
const rup=x=>(x==null||!isFinite(x))?"—":"₹ "+x.toLocaleString("en-IN",{maximumFractionDigits:0});
const pc=x=>(x==null||!isFinite(x))?"—":(x*100).toFixed(2)+"%";
const pc1=x=>(x*100).toFixed(1)+"%";

const PURPOSES={
  sale100:  {label:"Sale of the whole business", discounts:false, basis:"equity",
             dlom:0, dloc:0,
             note:"A completed sale is itself the liquidity event, and the buyer acquires control. Neither discount applies. Report enterprise value as the deal headline and equity value as seller proceeds."},
  fundraise:{label:"Fundraise, pre-money", discounts:false, basis:"equity",
             dlom:0, dloc:0,
             note:"Report equity value undiscounted. The investor prices illiquidity into their own required return; do not do it for them."},
  rule11ua: {label:"Rule 11UA / FEMA pricing", discounts:false, basis:"pershare",
             dlom:0, dloc:0, weights:{dcf:1,comp:0,nav:0},
             note:"The rule prescribes the method and does not contemplate a marketability discount. Cash flow method only, undiscounted, per share."},
  esop:     {label:"ESOP grant or employee buyback", discounts:true, basis:"pershare",
             dlom:20, dloc:10,
             note:"An employee holds a small, illiquid, non-controlling parcel. A moderate stack applies: the holding is minority but the buyback route gives partial liquidity."},
  minority: {label:"Minority stake transfer", discounts:true, basis:"adjusted",
             dlom:25, dloc:18,
             note:"Illiquid and without control. The heaviest stack of the six: no exit route and no ability to force one."},
  estate:   {label:"Family settlement or estate", discounts:true, basis:"adjusted",
             dlom:25, dloc:15,
             note:"Illiquid, usually non-controlling. Document how each discount was derived; this is the part that gets challenged."}
};

function readInputs(){
  const ind=INDUSTRIES[sel.value];
  const m={riskFree:pct("riskFree"),matureERP:pct("matureERP"),crp:pct("crp"),tax:pct("tax")};
  const co={
    baseRevenue:n("baseRevenue"), baseEbitdaMargin:pct("baseEbitdaMargin"),
    baseDaToSales:pct("baseDaToSales"), baseCapexToSales:pct("baseCapexToSales"),
    receivableDays:n("receivableDays"), inventoryDays:n("inventoryDays"), payableDays:n("payableDays"),
    debt:n("debt"), cash:n("cash"), surplusAssets:n("surplusAssets"),
    minorityInterest:n("minorityInterest"), shares:n("shares"), icr:n("icr")
  };
  const P=PURPOSES[$("purpose").value];
  co.nav=n("nav");
  const a={growth:[pct("g1"),pct("g2"),pct("g3")],terminalGrowth:pct("terminalGrowth"),
           csrp:pct("csrp"),
           dlom:P.discounts?pct("dlom"):0,
           dloc:P.discounts?pct("dloc"):0};
  return {m,ind,co,a,P};
}

function render(){
  const {m,ind,co,a,P}=readInputs();
  $("dlom").disabled=!P.discounts; $("dloc").disabled=!P.discounts;
  $("purposeNote").textContent=P.note;
  const r=value(m,ind,co,a);
  if(!r){ $("flags").innerHTML='<li>Discount rate must exceed terminal growth. Lower terminal growth or raise the risk premium.</li>'; return; }

  // headline
  $("hEquity").textContent=cr(r.adj);
  $("hShare").textContent=rup(r.perShare);
  $("hWacc").textContent=pc(r.wacc);
  $("hMult").textContent=isFinite(r.impliedMult)? r.impliedMult.toFixed(1)+"×" : "—";
  $("hTv").textContent=pc1(r.tvShare);

  // bridge
  const rows=[
    ["Present value of years 1–10",r.pvExplicit,false],
    ["Present value of terminal value",r.pvTerminal,false],
    ["Enterprise value",r.ev,false,true],
    ["Less: net debt",-r.netDebt,true],
    ["Less: minority interest",-co.minorityInterest,true],
    ["Add: surplus assets",co.surplusAssets,false],
    ["Equity value",r.equity,false,true],
    [`Less: marketability discount at ${pc1(a.dlom)}`,-(r.equity-r.equity*(1-a.dlom)),true],
    ["Equity value, adjusted",r.adj,false,true]
  ];
  $("bridge").innerHTML=rows.map(([k,v,minus,total])=>
    `<tr class="${total?"total":""}"><td>${k}</td><td class="${minus?"minus":""}">${cr(v)}</td></tr>`).join("");

  // ---------- methods, football field, concluded value ----------
  const disc=(1-a.dlom)*(1-a.dloc);
  const toEquity=ev=>(ev-r.netDebt-co.minorityInterest+co.surplusAssets)*disc;
  const baseEbitda=co.baseRevenue*co.baseEbitdaMargin;
  const baseEbit=baseEbitda-co.baseRevenue*co.baseDaToSales;
  const interest=co.icr>0? baseEbit/co.icr : 0;
  const basePat=(baseEbit-interest)*(1-m.tax);

  const dcfCells=[];
  for(const dw of [-0.015,0,0.015]) for(const dg of [-0.005,0,0.005]){
    const g=a.terminalGrowth+dg, ww=r.wacc+dw;
    if(ww<=g) continue;
    const alt=value(m,ind,co,{...a,terminalGrowth:g},ww);
    if(alt) dcfCells.push(alt.adj);
  }
  const dcfLo=Math.min(...dcfCells), dcfHi=Math.max(...dcfCells);

  const evComp=baseEbitda*ind.evEbitda;
  const eqEvEbitda=toEquity(evComp);
  const eqPe=basePat>0? basePat*ind.pe*disc : null;
  const compVals=[eqEvEbitda, eqPe].filter(v=>v!=null && v>0);
  const compLo=compVals.length?Math.min(...compVals)*0.9:null;
  const compHi=compVals.length?Math.max(...compVals)*1.1:null;
  const compMid=compVals.length?compVals.reduce((x,y)=>x+y,0)/compVals.length:null;

  // NAV must sit on the same basis as everything else, or it cannot act as a floor
  const navFloor=co.nav*disc;

  // weights: earnings-led normally, asset-led if the business is not earning
  let wDcf=0.55,wComp=0.35,wNav=0.10;
  if(baseEbitda<=0 || basePat<=0){ wDcf=0; wComp=0.35; wNav=0.65; }
  if(compMid==null){ wComp=0; wDcf=0.85; wNav=0.15; }
  if(P.weights){ wDcf=P.weights.dcf; wComp=P.weights.comp; wNav=P.weights.nav; }
  const mid = wDcf*r.adj + wComp*(compMid??0) + wNav*navFloor;
  const halfWidth = Math.max(0.12, (dcfHi-dcfLo)/(2*Math.max(r.adj,1)));
  let cLo=mid*(1-halfWidth), cHi=mid*(1+halfWidth);
  if(navFloor>cLo && wNav>0){ cLo=navFloor; if(cHi<cLo) cHi=cLo*(1+halfWidth); }
  const midShown=Math.min(Math.max(mid,cLo),cHi);

  const perShareOf=v=>co.shares? v*100/co.shares : null;
  const reportBand = P.basis==="pershare"
      ? `${rup(perShareOf(cLo))} – ${rup(perShareOf(cHi))}`
      : `${cr(cLo)} – ${cr(cHi)}`;
  const reportMid = P.basis==="pershare" ? rup(perShareOf(midShown)) : cr(midShown);
  $("cBand").textContent=reportBand;
  $("cMid").textContent=reportMid;
  $("cBandLabel").textContent = P.basis==="pershare" ? "Concluded range, per share" : "Concluded range";
  $("basisNote").textContent = `${P.label}. Reported on ${a.dlom||a.dloc? "a discounted basis" : "an undiscounted basis"}, weighted across methods.`;

  // football field
  const all=[dcfLo,dcfHi,compLo,compHi,navFloor,cLo,cHi].filter(v=>v!=null&&isFinite(v));
  const axLo=Math.min(...all)*0.9, axHi=Math.max(...all)*1.05, span=(axHi-axLo)||1;
  const posn=v=>((v-axLo)/span)*100;
  const barRow=(lab,sub,lo,hi,point,cls="")=>{
    if(lo==null) return "";
    const l=posn(lo), wdt=Math.max(0.6,posn(hi)-l);
    return `<div class="fbar ${cls}"><div class="lab">${lab}<em>${sub}</em></div>
      <div class="fline"><div class="rangebar" style="left:${l}%;width:${wdt}%"></div>
      ${point!=null?`<div class="point" style="left:${posn(point)}%"></div>`:""}
      <div class="tag" style="left:calc(${Math.min(l+wdt,86)}% + 8px)">${cr((lo+hi)/2)}</div></div></div>`;
  };
  $("fieldChart").innerHTML=
    barRow("Discounted cash flow",`weight ${(wDcf*100).toFixed(0)}%`,dcfLo,dcfHi,r.adj)+
    (compLo!=null?barRow("Trading multiples",`EV/EBITDA ${ind.evEbitda.toFixed(1)}× · P/E ${ind.pe}×`,compLo,compHi,compMid):"")+
    barRow("Net asset value",`floor, weight ${(wNav*100).toFixed(0)}%`,navFloor*0.98,navFloor*1.02,navFloor,"floor")+
    barRow("Concluded","weighted",cLo,cHi,midShown,"concl")+
    `<div class="axis"><span>${cr(axLo)}</span><span>${cr(axHi)}</span></div>`;

  const mRows=[
    ["Discounted cash flow", r.adj, wDcf],
    ["EV / EBITDA comparable", eqEvEbitda, null],
    ["P / E comparable", eqPe, null],
    ["Trading multiples, mean", compMid, wComp],
    ["Net asset value", navFloor, wNav]
  ];
  $("methods").innerHTML=
    "<thead><tr><th>Method</th><th>Equity value</th><th>Per share</th><th>Weight</th></tr></thead><tbody>"+
    mRows.map(([k,v,wt])=>v==null?"":`<tr><td>${k}</td><td>${cr(v)}</td><td>${rup(perShareOf(v))}</td>`+
      `<td>${wt==null?"—":(wt*100).toFixed(0)+"%"}</td></tr>`).join("")+
    `<tr class="concl"><td>Concluded, midpoint</td><td>${cr(midShown)}</td><td>${rup(perShareOf(midShown))}</td><td>100%</td></tr>`+
    "</tbody>";

  if(compMid!=null){
    const gap=Math.abs(r.adj-compMid)/Math.max(compMid,1);
    if(gap>0.30) r.flags.push(`The cash flow result and the trading multiples are ${(gap*100).toFixed(0)}% apart. Do not average past this — either the projections are heroic relative to how the market prices ${ind.label.toLowerCase()}, or these comparables do not fit the business. Explain which in the report.`);
  }
  if(r.adj<navFloor && wNav>0) r.flags.push("Earnings-based value is below adjusted net asset value. Either the projections understate the business or the assets are worth more deployed elsewhere. Say which.");

  // wacc ladder
  const w=r.w, max=Math.max(w.ke,w.kd)*1.05;
  const bar=(v,cls="")=>`<div class="track"><span class="${cls}" style="width:${Math.max(0,Math.min(100,v/max*100))}%"></span></div>`;
  $("ladder").innerHTML=`
    <div class="rung"><div class="lab">Risk-free rate</div>${bar(m.riskFree)}<div class="val">${pc(m.riskFree)}</div></div>
    <div class="rung"><div class="lab">Beta ${w.beta.toFixed(2)} × ERP ${pc1(w.erp)}</div>${bar(w.betaPremium)}<div class="val">${pc(w.betaPremium)}</div></div>
    <div class="rung"><div class="lab">Company-specific risk</div>${bar(a.csrp)}<div class="val">${pc(a.csrp)}</div></div>
    <div class="rung sum"><div class="lab">Cost of equity</div>${bar(w.ke)}<div class="val">${pc(w.ke)}</div></div>
    <div class="rung debt"><div class="lab">Cost of debt, post-tax</div>${bar(w.kdAt)}<div class="val">${pc(w.kdAt)}</div></div>
    <div class="rung sum"><div class="lab">WACC at ${pc1(w.we)} equity</div>${bar(r.wacc)}<div class="val">${pc(r.wacc)}</div></div>`;

  // projection
  const head=["Year","Revenue","Growth","EBITDA margin","EBIT","NOPAT","Capex","Δ Working capital","FCFF","Discounted"];
  $("proj").innerHTML=
    "<thead><tr>"+head.map(h=>`<th>${h}</th>`).join("")+"</tr></thead><tbody>"+
    r.proj.map(p=>`<tr class="${p.fading?"fade":""}"><td>Year ${p.y}</td><td>${p.rev.toFixed(1)}</td>`+
      `<td>${pc1(p.g)}</td><td>${pc1(p.margin)}</td><td>${p.ebit.toFixed(1)}</td>`+
      `<td>${p.nopat.toFixed(1)}</td><td>${p.capex.toFixed(1)}</td><td>${p.dWc.toFixed(1)}</td>`+
      `<td>${p.fcff.toFixed(1)}</td><td>${p.pv.toFixed(1)}</td></tr>`).join("")+
    "</tbody><tfoot><tr><td>Total discounted</td>"+"<td></td>".repeat(8)+
    `<td>${r.pvExplicit.toFixed(1)}</td></tr></tfoot>`;

  // sensitivity
  const wD=[-0.02,-0.01,0,0.01,0.02], gD=[-0.01,-0.005,0,0.005,0.01];
  const cells=[];
  for(const dw of wD){ const row=[];
    for(const dg of gD){
      const g=a.terminalGrowth+dg, ww=r.wacc+dw;
      const alt=(ww<=g)?null:value(m,ind,co,{...a,terminalGrowth:g},ww);
      row.push(alt? alt.adj : null);
    } cells.push(row); }
  const flat=cells.flat().filter(v=>v!=null);
  const lo=Math.min(...flat), hi=Math.max(...flat);
  const shade=v=>{ if(v==null) return "background:#f6f7f6;color:#9aa5a0";
    const t=(v-lo)/((hi-lo)||1);
    return `background:rgba(14,90,72,${0.06+t*0.30})`; };
  $("sens").innerHTML=
    "<thead><tr><th>WACC ╲ terminal g</th>"+gD.map(dg=>`<th>${pc1(a.terminalGrowth+dg)}</th>`).join("")+"</tr></thead><tbody>"+
    cells.map((row,i)=>`<tr><th>${pc1(r.wacc+wD[i])}</th>`+
      row.map((v,j)=>`<td class="${(wD[i]===0&&gD[j]===0)?"base":""}" style="${shade(v)}">${v==null?"—":v.toFixed(1)}</td>`).join("")+
      "</tr>").join("")+"</tbody>";

  // ---------- tornado: one driver at a time ----------
  const flex=(coΔ,aΔ)=>{
    const alt=value(m,ind,{...co,...coΔ},{...a,...aΔ});
    return alt? alt.adj : null;
  };
  const drivers=[
    {lab:"Revenue growth, years 1–3", rng:"±3 percentage points",
     lo:()=>flex({},{growth:a.growth.map(g=>g-0.03)}), hi:()=>flex({},{growth:a.growth.map(g=>g+0.03)})},
    {lab:"EBITDA margin, normalised", rng:"±150 basis points",
     lo:()=>flex({baseEbitdaMargin:co.baseEbitdaMargin-0.015},{}), hi:()=>flex({baseEbitdaMargin:co.baseEbitdaMargin+0.015},{})},
    {lab:"Company-specific risk", rng:"±100 basis points",
     lo:()=>flex({},{csrp:a.csrp+0.01}), hi:()=>flex({},{csrp:Math.max(0,a.csrp-0.01)})},
    {lab:"Terminal growth", rng:"±50 basis points",
     lo:()=>flex({},{terminalGrowth:a.terminalGrowth-0.005}), hi:()=>flex({},{terminalGrowth:a.terminalGrowth+0.005})},
    {lab:"Capex ÷ revenue", rng:"±150 basis points",
     lo:()=>flex({baseCapexToSales:co.baseCapexToSales+0.015},{}), hi:()=>flex({baseCapexToSales:Math.max(0,co.baseCapexToSales-0.015)},{})},
    {lab:"Receivable days", rng:"±20 days",
     lo:()=>flex({receivableDays:co.receivableDays+20},{}), hi:()=>flex({receivableDays:Math.max(0,co.receivableDays-20)},{})},
    {lab:"Interest coverage", rng:"±1.0×",
     lo:()=>flex({icr:Math.max(0.5,co.icr-1)},{}), hi:()=>flex({icr:co.icr+1},{})}
  ];
  if(a.dlom>0) drivers.push({lab:"Marketability discount", rng:"±5 percentage points",
     lo:()=>flex({},{dlom:Math.min(0.6,a.dlom+0.05)}), hi:()=>flex({},{dlom:Math.max(0,a.dlom-0.05)})});

  const tor=drivers.map(dv=>{
    const lo=dv.lo(), hi=dv.hi();
    return {...dv,lo,hi,span:(lo==null||hi==null)?0:Math.abs(hi-lo)};
  }).filter(dv=>dv.span>0).sort((x,y)=>y.span-x.span);

  const base=r.adj;
  const tMin=Math.min(base,...tor.map(t=>t.lo)), tMax=Math.max(base,...tor.map(t=>t.hi));
  const tPad=(tMax-tMin)*0.06||1, tLo=tMin-tPad, tHi=tMax+tPad, tSpan=tHi-tLo;
  const tp=v=>((v-tLo)/tSpan)*100;
  $("tornado").innerHTML=tor.map(t=>{
    const b=tp(base), l=tp(t.lo), h=tp(t.hi);
    return `<div class="trow"><div class="lab">${t.lab}<em>${t.rng}</em></div>
      <div class="tline">
        <div class="neg" style="left:${Math.min(l,b)}%;width:${Math.abs(b-l)}%"></div>
        <div class="pos" style="left:${Math.min(h,b)}%;width:${Math.abs(h-b)}%"></div>
        <div class="mid" style="left:${b}%"></div>
      </div>
      <div class="swing">${(t.span/Math.abs(base||1)*100).toFixed(0)}% swing</div></div>`;
  }).join("")+`<div class="axis"><span>${cr(tLo)}</span><span>your case ${cr(base)}</span><span>${cr(tHi)}</span></div>`;

  // ---------- scenarios ----------
  const scenarios=[
    {name:"Downside", desc:"Growth 4pp lower, margin 200bp thinner, risk premium 150bp higher, capex 100bp heavier",
     co:{baseEbitdaMargin:co.baseEbitdaMargin-0.02, baseCapexToSales:co.baseCapexToSales+0.01, receivableDays:co.receivableDays+15},
     a:{growth:a.growth.map(g=>g-0.04), csrp:a.csrp+0.015, terminalGrowth:Math.max(0.01,a.terminalGrowth-0.005)}},
    {name:"Your case", desc:"As entered", co:{}, a:{}, isBase:true},
    {name:"Upside", desc:"Growth 4pp higher, margin 200bp fatter, risk premium 100bp lower, capex 100bp lighter",
     co:{baseEbitdaMargin:co.baseEbitdaMargin+0.02, baseCapexToSales:Math.max(0,co.baseCapexToSales-0.01), receivableDays:Math.max(0,co.receivableDays-15)},
     a:{growth:a.growth.map(g=>g+0.04), csrp:Math.max(0,a.csrp-0.01), terminalGrowth:a.terminalGrowth+0.005}}
  ];
  $("scen").innerHTML="<thead><tr><th>Scenario</th><th>Assumptions moved</th><th>WACC</th>"+
    "<th>Enterprise value</th><th>Equity value</th><th>Per share</th></tr></thead><tbody>"+
    scenarios.map(sc=>{
      const alt=sc.isBase? r : value(m,ind,{...co,...sc.co},{...a,...sc.a});
      if(!alt) return `<tr><td>${sc.name}</td><td class="desc" colspan="5">Not feasible: discount rate falls below terminal growth.</td></tr>`;
      return `<tr class="${sc.isBase?"base":""}"><td>${sc.name}</td><td class="desc">${sc.desc}</td>`+
        `<td>${pc(alt.wacc)}</td><td>${cr(alt.ev)}</td><td>${cr(alt.adj)}</td>`+
        `<td>${rup(perShareOf(alt.adj))}</td></tr>`;
    }).join("")+"</tbody>";

  // gap questions, ranked by value sensitivity
  const probes=[
    {key:"csrp",  q:"How concentrated is revenue? Share of the top three customers, and are they on contract?",
     why:"Sets the company-specific risk premium.", apply:x=>({...a,csrp:a.csrp+x*0.015})},
    {key:"g1",    q:"What is the confirmed order book or committed pipeline for the coming year?",
     why:"Anchors near-term growth instead of extrapolating history.", apply:x=>({...a,growth:[a.growth[0]+x*0.05,a.growth[1],a.growth[2]]})},
    {key:"capex", q:"Any capacity expansion planned in the next three years, and how will it be funded?",
     why:"Changes capex intensity and the cash available to owners.", applyCo:x=>({...co,baseCapexToSales:co.baseCapexToSales+x*0.02})},
    {key:"margin",q:"What does the promoter draw as remuneration, and what would a professional in that role cost?",
     why:"Normalised margin is the single largest lever in an owner-managed business.", applyCo:x=>({...co,baseEbitdaMargin:co.baseEbitdaMargin+x*0.02})},
    {key:"wc",    q:"Are receivables ageing beyond 90 days, and is any of it disputed?",
     why:"Working capital days feed straight into cash flow.", applyCo:x=>({...co,receivableDays:co.receivableDays+x*20})}
  ];
  const ranked=probes.map(p=>{
    const up=value(m,ind,p.applyCo?p.applyCo(1):co,p.apply?p.apply(1):a);
    const dn=value(m,ind,p.applyCo?p.applyCo(-1):co,p.apply?p.apply(-1):a);
    const swing=(up&&dn)? Math.abs(up.adj-dn.adj)/Math.abs(r.adj||1)*100 : 0;
    return {...p,swing};
  }).sort((x,y)=>y.swing-x.swing).filter(p=>p.swing>2).slice(0,4);

  $("questions").innerHTML=ranked.map(p=>
    `<li><div class="q">${p.q}</div><div class="why">${p.why} A plausible range here moves equity value by about ${p.swing.toFixed(0)}%.</div></li>`
  ).join("") || '<li><div class="q">Nothing material is missing.</div></li>';

  // flags
  $("flags").innerHTML = r.flags.length
    ? r.flags.map(f=>`<li>${f}</li>`).join("")
    : '<li style="border-left-color:#b6c1bb;background:#f2f5f3" class="ok">No consistency checks triggered. Terminal growth is within the risk-free rate, the terminal share of value is reasonable, and reinvestment supports the assumed growth.</li>';
}

// shade untouched fields as "assumed"
document.querySelectorAll("#rail input, #rail select").forEach(el=>{
  const wrap=el.closest(".field")||el.parentElement;
  if(el.tagName==="INPUT") wrap.classList.add("assumed");
  el.addEventListener("input",()=>{ wrap.classList.remove("assumed"); touched.add(el.id); render(); });
  el.addEventListener("change",render);
});
$("purpose").addEventListener("change",()=>{
  const P=PURPOSES[$("purpose").value];
  $("dlom").value=P.dlom; $("dloc").value=P.dloc;
  [$("dlom"),$("dloc")].forEach(el=>el.closest(".field").classList.remove("assumed"));
  render();
});
(function seed(){const P=PURPOSES[$("purpose").value];$("dlom").value=P.dlom;$("dloc").value=P.dloc;})();
render();
</script>
