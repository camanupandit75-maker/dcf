<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Valuation workbench — DCF for unlisted Indian companies</title>
<style>
  :root{
    --paper:#ffffff;
    --panel:#f2f5f3;
    --ink:#15201c;
    --ink-2:#4a5751;
    --ink-3:#78857f;
    --rule:#d7ded9;
    --rule-strong:#b6c1bb;
    --accent:#0e5a48;
    --accent-soft:#e2efe9;
    --amber:#8f5c06;
    --amber-soft:#f8eedc;
    --red:#8c2f1d;
    --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    --sans:ui-sans-serif,system-ui,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--paper);color:var(--ink);
    font-family:var(--sans);font-size:15px;line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .num{font-variant-numeric:tabular-nums lining-nums}

  header.masthead{
    border-bottom:1px solid var(--rule);
    padding:22px 28px 18px;
    display:flex;align-items:baseline;gap:18px;flex-wrap:wrap;
  }
  .masthead h1{
    font-family:var(--serif);font-weight:600;font-size:23px;
    letter-spacing:-.01em;margin:0;
  }
  .masthead p{margin:0;color:var(--ink-3);font-size:13.5px}

  .shell{display:grid;grid-template-columns:376px minmax(0,1fr);gap:0;align-items:start}
  @media (max-width:940px){.shell{grid-template-columns:1fr}}

  /* ---------- input rail ---------- */
  .rail{
    border-right:1px solid var(--rule);
    background:var(--panel);
    padding:20px 22px 60px;
    position:sticky;top:0;max-height:100vh;overflow-y:auto;
  }
  @media (max-width:940px){.rail{position:static;max-height:none;border-right:none;border-bottom:1px solid var(--rule)}}

  .rail h2{
    font-family:var(--serif);font-size:15px;font-weight:600;margin:26px 0 10px;
    padding-bottom:6px;border-bottom:1px solid var(--rule-strong);
  }
  .rail h2:first-child{margin-top:0}

  .field{display:grid;grid-template-columns:1fr 96px;gap:10px;align-items:center;margin:0 0 7px}
  .field label{font-size:13.5px;color:var(--ink-2)}
  .field .unit{font-size:12px;color:var(--ink-3)}
  input[type=number],select{
    font-family:var(--sans);font-size:14px;color:var(--ink);
    background:var(--paper);border:1px solid var(--rule-strong);border-radius:3px;
    padding:5px 7px;width:100%;font-variant-numeric:tabular-nums;
  }
  select{grid-column:1/-1;width:100%}
  input:focus-visible,select:focus-visible,button:focus-visible{
    outline:2px solid var(--accent);outline-offset:1px;
  }
  .assumed input{background:var(--amber-soft);border-color:#e0cba0}
  .rail .note{font-size:12px;color:var(--ink-3);margin:8px 0 0}

  /* ---------- results ---------- */
  main{padding:26px 30px 80px;min-width:0}
  section{margin-bottom:38px}
  section > h3{
    font-family:var(--serif);font-size:17px;font-weight:600;margin:0 0 4px;
  }
  section > .sub{color:var(--ink-3);font-size:13px;margin:0 0 16px}

  .headline{display:flex;gap:44px;flex-wrap:wrap;align-items:flex-end;
    border-bottom:2px solid var(--ink);padding-bottom:16px;margin-bottom:8px}
  .headline .primary .v{
    font-family:var(--serif);font-size:46px;line-height:1;font-weight:600;
    letter-spacing:-.02em;display:block;
  }
  .headline .primary .k{font-size:13px;color:var(--ink-2);display:block;margin-top:7px}
  .headline .secondary{display:flex;gap:32px;flex-wrap:wrap}
  .headline .secondary div .v{font-family:var(--serif);font-size:21px;display:block}
  .headline .secondary div .k{font-size:12.5px;color:var(--ink-3)}

  /* bridge */
  .bridge{margin-top:14px;border-collapse:collapse;width:100%;max-width:520px}
  .bridge td{padding:5px 0;font-size:14px;border-bottom:1px dotted var(--rule)}
  .bridge td:last-child{text-align:right;font-variant-numeric:tabular-nums}
  .bridge tr.total td{border-bottom:none;border-top:1px solid var(--ink);font-weight:600;padding-top:8px}
  .bridge td.minus:last-child{color:var(--red)}

  /* wacc ladder */
  .ladder{max-width:620px}
  .rung{display:grid;grid-template-columns:150px 1fr 74px;gap:12px;align-items:center;margin-bottom:6px}
  .rung .lab{font-size:13.5px;color:var(--ink-2)}
  .rung .val{text-align:right;font-variant-numeric:tabular-nums;font-size:14px}
  .track{height:16px;background:#e7ebe8;position:relative;border-radius:2px;overflow:hidden}
  .track span{position:absolute;top:0;bottom:0;left:0;background:var(--accent);opacity:.85}
  .rung.sum .lab,.rung.sum .val{font-weight:600;color:var(--ink)}
  .rung.sum .track span{opacity:1}
  .rung.debt .track span{background:#7b8f88}

  /* projection table */
  .scroller{overflow-x:auto;border:1px solid var(--rule);border-radius:3px}
  table.proj{border-collapse:collapse;width:100%;min-width:820px;font-size:13.5px}
  table.proj th,table.proj td{padding:7px 11px;text-align:right;white-space:nowrap;
    font-variant-numeric:tabular-nums}
  table.proj th{
    font-family:var(--sans);font-weight:600;font-size:12.5px;color:var(--ink-2);
    border-bottom:1px solid var(--rule-strong);background:var(--panel);position:sticky;top:0;
  }
  table.proj th:first-child,table.proj td:first-child{text-align:left}
  table.proj tbody tr:nth-child(even){background:#fafbfa}
  table.proj tbody tr.fade td:first-child::after{
    content:" fade";color:var(--ink-3);font-size:11px;
  }
  table.proj tfoot td{border-top:1px solid var(--ink);font-weight:600;padding-top:9px}

  /* sensitivity */
  table.sens{border-collapse:collapse;font-size:13px}
  table.sens th,table.sens td{padding:7px 12px;text-align:right;font-variant-numeric:tabular-nums;
    border:1px solid var(--paper)}
  table.sens th{color:var(--ink-2);font-weight:600;font-size:12px;background:var(--panel)}
  table.sens td.base{outline:2px solid var(--ink);outline-offset:-2px;font-weight:600}

  /* questions + flags */
  ol.questions{margin:0;padding:0;list-style:none;counter-reset:q}
  ol.questions li{
    border-left:3px solid var(--accent);background:var(--accent-soft);
    padding:11px 14px;margin-bottom:9px;border-radius:0 3px 3px 0;
  }
  ol.questions li .q{font-size:14.5px}
  ol.questions li .why{font-size:12.5px;color:var(--ink-2);margin-top:3px}

  .flags li{
    border-left:3px solid var(--amber);background:var(--amber-soft);
    padding:10px 14px;margin-bottom:8px;font-size:13.5px;list-style:none;border-radius:0 3px 3px 0;
  }
  .flags{padding:0;margin:0}
  .ok{color:var(--ink-3);font-size:13.5px}

  /* concluded value */
  .concluded{display:flex;gap:40px;flex-wrap:wrap;align-items:flex-end;margin-bottom:20px}
  .concluded .band{font-family:var(--serif);font-size:34px;line-height:1;font-weight:600;letter-spacing:-.02em}
  .concluded .k{font-size:13px;color:var(--ink-2);margin-top:6px}

  .field-chart{max-width:660px}
  .fbar{display:grid;grid-template-columns:150px 1fr;gap:14px;align-items:center;margin-bottom:11px}
  .fbar .lab{font-size:13.5px;color:var(--ink-2)}
  .fbar .lab em{font-style:normal;color:var(--ink-3);font-size:12px;display:block}
  .fline{position:relative;height:26px}
  .fline .rangebar{position:absolute;top:7px;height:12px;background:var(--accent);opacity:.30;border-radius:2px}
  .fline .point{position:absolute;top:3px;width:2px;height:20px;background:var(--ink)}
  .fline .tag{position:absolute;top:4px;font-size:12px;font-variant-numeric:tabular-nums;color:var(--ink-2)}
  .fbar.concl .rangebar{opacity:.55}
  .fbar.floor .rangebar{background:#7b8f88;opacity:.35}
  .axis{display:flex;justify-content:space-between;font-size:11.5px;color:var(--ink-3);
    border-top:1px solid var(--rule);padding-top:5px;margin-left:164px}

  table.methods{border-collapse:collapse;width:100%;max-width:660px;font-size:13.5px;margin-top:20px}
  table.methods th,table.methods td{padding:7px 10px;border-bottom:1px solid var(--rule);
    text-align:right;font-variant-numeric:tabular-nums}
  table.methods th{font-size:12.5px;color:var(--ink-2);font-weight:600;text-align:right}
  table.methods th:first-child,table.methods td:first-child{text-align:left}
  table.methods tr.concl td{border-top:1px solid var(--ink);border-bottom:none;font-weight:600}

  /* tornado */
  .tornado{max-width:680px}
  .trow{display:grid;grid-template-columns:190px 1fr 96px;gap:12px;align-items:center;margin-bottom:8px}
  .trow .lab{font-size:13.5px;color:var(--ink-2)}
  .trow .lab em{font-style:normal;display:block;font-size:11.5px;color:var(--ink-3)}
  .tline{position:relative;height:22px;background:#eef1ef;border-radius:2px}
  .tline .neg{position:absolute;top:0;bottom:0;background:#a8503c;opacity:.55}
  .tline .pos{position:absolute;top:0;bottom:0;background:var(--accent);opacity:.55}
  .tline .mid{position:absolute;top:-3px;bottom:-3px;width:1px;background:var(--ink)}
  .trow .swing{text-align:right;font-size:13px;font-variant-numeric:tabular-nums;color:var(--ink-2)}

  /* scenarios */
  table.scen{border-collapse:collapse;width:100%;max-width:680px;font-size:13.5px}
  table.scen th,table.scen td{padding:8px 11px;border-bottom:1px solid var(--rule);
    text-align:right;font-variant-numeric:tabular-nums}
  table.scen th{font-size:12.5px;color:var(--ink-2);font-weight:600}
  table.scen th:first-child,table.scen td:first-child{text-align:left}
  table.scen td.desc{font-variant-numeric:normal;color:var(--ink-3);font-size:12.5px}
  table.scen tr.base td{background:var(--panel);font-weight:600}

  footer{border-top:1px solid var(--rule);padding:18px 30px 40px;color:var(--ink-3);font-size:12.5px}
</style>
</head>
<body>

<header class="masthead">
  <h1>Valuation workbench</h1>
  <p>Discounted cash flow for unlisted Indian companies · prototype</p>
</header>

<div class="shell">

  <!-- ============ INPUT RAIL ============ -->
  <form class="rail" id="rail" autocomplete="off">
    <h2>Purpose</h2>
    <div class="field"><label for="purpose">This valuation is for</label></div>
    <select id="purpose">
      <option value="sale100">Sale of the whole business</option>
      <option value="fundraise">Fundraise, pre-money</option>
      <option value="rule11ua">Rule 11UA / FEMA pricing</option>
      <option value="esop" selected>ESOP grant or employee buyback</option>
      <option value="minority">Minority stake transfer</option>
      <option value="estate">Family settlement or estate</option>
    </select>
    <p class="note" id="purposeNote"></p>

    <h2>Company</h2>
    <div class="field"><label for="industry">Industry</label></div>
    <select id="industry"></select>
    <p class="note">Industry medians drive margin fade, capex and terminal returns.</p>

    <div class="field"><label for="baseRevenue">Revenue, latest year</label>
      <input type="number" id="baseRevenue" value="50" step="0.1"></div>
    <div class="field"><label for="baseEbitdaMargin">EBITDA margin, normalised</label>
      <input type="number" id="baseEbitdaMargin" value="14" step="0.1"></div>
    <div class="field"><label for="baseDaToSales">Depreciation ÷ revenue</label>
      <input type="number" id="baseDaToSales" value="3.2" step="0.1"></div>
    <div class="field"><label for="baseCapexToSales">Capex ÷ revenue</label>
      <input type="number" id="baseCapexToSales" value="5" step="0.1"></div>

    <h2>Working capital</h2>
    <div class="field"><label for="receivableDays">Receivable days</label>
      <input type="number" id="receivableDays" value="72" step="1"></div>
    <div class="field"><label for="inventoryDays">Inventory days</label>
      <input type="number" id="inventoryDays" value="55" step="1"></div>
    <div class="field"><label for="payableDays">Payable days</label>
      <input type="number" id="payableDays" value="48" step="1"></div>

    <h2>Balance sheet</h2>
    <div class="field"><label for="debt">Total debt</label>
      <input type="number" id="debt" value="18" step="0.1"></div>
    <div class="field"><label for="cash">Cash and equivalents</label>
      <input type="number" id="cash" value="4" step="0.1"></div>
    <div class="field"><label for="surplusAssets">Surplus non-operating assets</label>
      <input type="number" id="surplusAssets" value="0" step="0.1"></div>
    <div class="field"><label for="minorityInterest">Minority interest</label>
      <input type="number" id="minorityInterest" value="0" step="0.1"></div>
    <div class="field"><label for="nav">Net asset value (adjusted book)</label>
      <input type="number" id="nav" value="21" step="0.1"></div>
    <div class="field"><label for="shares">Shares outstanding (lakh)</label>
      <input type="number" id="shares" value="100" step="1"></div>

    <h2>Growth</h2>
    <div class="field"><label for="g1">Revenue growth, year 1</label>
      <input type="number" id="g1" value="18" step="0.5"></div>
    <div class="field"><label for="g2">Year 2</label>
      <input type="number" id="g2" value="15" step="0.5"></div>
    <div class="field"><label for="g3">Year 3</label>
      <input type="number" id="g3" value="13" step="0.5"></div>
    <div class="field"><label for="terminalGrowth">Terminal growth</label>
      <input type="number" id="terminalGrowth" value="5.5" step="0.1"></div>

    <h2>Risk and discounts</h2>
    <div class="field"><label for="csrp">Company-specific risk premium</label>
      <input type="number" id="csrp" value="3.5" step="0.25"></div>
    <div class="field"><label for="icr">Interest coverage (EBIT ÷ interest)</label>
      <input type="number" id="icr" value="3.2" step="0.1"></div>
    <div class="field"><label for="dlom">Discount for lack of marketability</label>
      <input type="number" id="dlom" value="25" step="1"></div>
    <div class="field"><label for="dloc">Minority stake discount</label>
      <input type="number" id="dloc" value="0" step="1"></div>

    <h2>Market</h2>
    <div class="field"><label for="riskFree">Risk-free rate (10Y G-sec)</label>
      <input type="number" id="riskFree" value="6.85" step="0.05"></div>
    <div class="field"><label for="matureERP">Mature market equity risk premium</label>
      <input type="number" id="matureERP" value="4.3" step="0.05"></div>
    <div class="field"><label for="crp">India country risk premium</label>
      <input type="number" id="crp" value="2.6" step="0.05"></div>
    <div class="field"><label for="tax">Marginal tax rate</label>
      <input type="number" id="tax" value="25.17" step="0.01"></div>
    <p class="note">Amounts in ₹ crore. Rates in per cent. Shaded fields are still carrying defaults — nobody has confirmed them.</p>
  </form>

  <!-- ============ RESULTS ============ -->
  <main>
    <section>
      <div class="headline">
        <div class="primary">
          <span class="v num" id="hEquity">—</span>
          <span class="k">Equity value after marketability discount</span>
        </div>
        <div class="secondary">
          <div><span class="v num" id="hShare">—</span><span class="k">Per share</span></div>
          <div><span class="v num" id="hWacc">—</span><span class="k">WACC</span></div>
          <div><span class="v num" id="hMult">—</span><span class="k">Implied EV / EBITDA</span></div>
          <div><span class="v num" id="hTv">—</span><span class="k">Value in terminal year</span></div>
        </div>
      </div>
      <table class="bridge num" id="bridge"></table>
    </section>

    <section>
      <h3>Concluded value</h3>
      <p class="sub" id="basisNote"></p>
      <div class="concluded">
        <div><div class="band num" id="cBand">—</div><div class="k" id="cBandLabel">Concluded range</div></div>
        <div><div class="band num" id="cMid">—</div><div class="k">Midpoint</div></div>
      </div>
      <div class="field-chart" id="fieldChart"></div>
      <table class="methods" id="methods"></table>
    </section>

    <section>
      <h3>How the discount rate is built</h3>
      <p class="sub">Bottom-up: industry beta relevered at the target capital structure, then loaded for company-specific risk.</p>
      <div class="ladder" id="ladder"></div>
    </section>

    <section>
      <h3>Ten-year free cash flow to the firm</h3>
      <p class="sub">Years 1–3 are yours. From year 4 growth, margin and capex intensity fade linearly toward the industry median.</p>
      <div class="scroller"><table class="proj" id="proj"></table></div>
    </section>

    <section>
      <h3>What moves the answer</h3>
      <p class="sub">Equity value across discount rate and terminal growth. Your case is outlined.</p>
      <div class="scroller"><table class="sens" id="sens"></table></div>
    </section>

    <section>
      <h3>Which assumption carries the value</h3>
      <p class="sub">Each driver flexed on its own, everything else held at your case. The wider the bar, the more the report rests on that one number.</p>
      <div class="tornado" id="tornado"></div>
    </section>

    <section>
      <h3>Scenarios</h3>
      <p class="sub">Drivers moved together, the way they actually move together.</p>
      <div class="scroller"><table class="scen" id="scen"></table></div>
    </section>

    <section>
      <h3>Questions worth asking the client</h3>
      <p class="sub">Ranked by how much the answer could move equity value, not by form order.</p>
      <ol class="questions" id="questions"></ol>
    </section>

    <section>
      <h3>Checks</h3>
      <ul class="flags" id="flags"></ul>
    </section>
  </main>
</div>

<footer>
  Prototype only. Industry medians below are illustrative placeholders — in the live product they come from a versioned dataset pinned to each valuation, so a locked report reproduces exactly.
</footer>

<script>
// ---------------------------------------------------------------
// Illustrative industry reference data (replace with versioned dataset)
// ---------------------------------------------------------------
const INDUSTRIES = {
  auto_components:   {label:"Auto components",              beta:1.05, de:0.35, ebitda:0.135, capex:0.045, roic:0.13, evEbitda:12.0, pe:19},
  it_services:       {label:"IT services",                  beta:0.95, de:0.05, ebitda:0.220, capex:0.020, roic:0.28, evEbitda:16.0, pe:24},
  pharma:            {label:"Pharmaceuticals",              beta:0.90, de:0.20, ebitda:0.210, capex:0.060, roic:0.14, evEbitda:15.0, pe:26},
  specialty_chem:    {label:"Specialty chemicals",          beta:1.00, de:0.30, ebitda:0.180, capex:0.070, roic:0.15, evEbitda:14.0, pe:22},
  engineering:       {label:"Engineering and capital goods",beta:1.10, de:0.30, ebitda:0.120, capex:0.040, roic:0.12, evEbitda:13.0, pe:21},
  textiles:          {label:"Textiles and apparel",         beta:0.95, de:0.60, ebitda:0.110, capex:0.050, roic:0.09, evEbitda: 8.0, pe:14},
  food_processing:   {label:"Food processing",              beta:0.80, de:0.40, ebitda:0.100, capex:0.045, roic:0.11, evEbitda:11.0, pe:18},
  logistics:         {label:"Logistics and warehousing",    beta:0.90, de:0.45, ebitda:0.140, capex:0.080, roic:0.10, evEbitda: 9.0, pe:16},
  retail:            {label:"Retail and distribution",      beta:0.85, de:0.35, ebitda:0.070, capex:0.030, roic:0.12, evEbitda:10.0, pe:17}
};

const sel = document.getElementById("industry");
Object.entries(INDUSTRIES).forEach(([k,v])=>{
  const o=document.createElement("option"); o.value=k; o.textContent=v.label; sel.appendChild(o);
});
sel.value="auto_components";

// ---------------------------------------------------------------
// Engine — deterministic, mirrors engine.ts
// ---------------------------------------------------------------
const releverBeta=(bu,de,t)=>bu*(1+(1-t)*de);

function syntheticCostOfDebt(rf,icr){
  if(!isFinite(icr)) return rf+0.045;
  const s = icr>8?0.011: icr>6?0.015: icr>4.5?0.020: icr>3?0.0275:
            icr>2.5?0.035: icr>2?0.045: icr>1.5?0.060: icr>1.25?0.080:0.110;
  return rf+s;
}

function computeWacc(m,ind,co,a){
  const de=co.targetDebtEquity ?? ind.de;
  const beta=releverBeta(ind.beta,de,m.tax);
  const erp=m.matureERP+m.crp;
  const ke=m.riskFree+beta*erp+a.csrp;
  const kd=syntheticCostOfDebt(m.riskFree,co.icr);
  const kdAt=kd*(1-m.tax);
  const wd=de/(1+de), we=1-wd;
  return {beta,erp,ke,kd,kdAt,we,wd,betaPremium:beta*erp,
          wacc:we*ke+wd*kdAt};
}

const lerp=(a,b,s,n)=> n<=0? b : a+((b-a)*s)/n;

function wcap(rev,co,margin){
  const cogs=rev*(1-margin);
  return rev*co.receivableDays/365 + cogs*co.inventoryDays/365 - cogs*co.payableDays/365;
}

function project(m,ind,co,a,wacc){
  const horizon=10, fadeStart=4, fadeSteps=horizon-fadeStart+1;
  const rows=[]; let rev=co.baseRevenue;
  let prevWc=wcap(co.baseRevenue,co,co.baseEbitdaMargin);
  for(let y=1;y<=horizon;y++){
    let g,margin,capexToSales,fading=false;
    if(y<=fadeStart-1){
      g=a.growth[Math.min(y-1,a.growth.length-1)];
      margin=co.baseEbitdaMargin; capexToSales=co.baseCapexToSales;
    } else {
      fading=true;
      const step=y-fadeStart+1, last=a.growth[a.growth.length-1];
      g=lerp(last,a.terminalGrowth,step,fadeSteps);
      margin=lerp(co.baseEbitdaMargin,ind.ebitda,step,fadeSteps);
      capexToSales=lerp(co.baseCapexToSales,ind.capex,step,fadeSteps);
    }
    rev=rev*(1+g);
    const ebitda=rev*margin, da=rev*co.baseDaToSales, ebit=ebitda-da;
    const nopat=ebit*(1-m.tax), capex=rev*capexToSales;
    const wc=wcap(rev,co,margin), dWc=wc-prevWc; prevWc=wc;
    const fcff=nopat+da-capex-dWc;
    const df=1/Math.pow(1+wacc,y-0.5);
    rows.push({y,rev,g,margin,ebitda,da,ebit,nopat,capex,dWc,fcff,df,pv:fcff*df,fading});
  }
  return rows;
}

function value(m,ind,co,aIn,waccOverride){
  const flags=[]; const a={...aIn};
  if(a.terminalGrowth>m.riskFree){
    flags.push(`Terminal growth of ${(aIn.terminalGrowth*100).toFixed(1)}% exceeds the risk-free rate and has been capped at ${(m.riskFree*100).toFixed(2)}%. No company grows faster than the economy forever.`);
    a.terminalGrowth=m.riskFree;
  }
  const w=computeWacc(m,ind,co,a);
  const wacc = waccOverride ?? w.wacc;
  if(wacc<=a.terminalGrowth) return null;
  if(wacc<0.11) flags.push(`A WACC of ${(wacc*100).toFixed(1)}% is low for an unlisted Indian company. Review the beta, the company-specific premium and the assumed capital structure.`);

  const proj=project(m,ind,co,a,wacc);
  const last=proj[proj.length-1];
  const reinvest=a.terminalGrowth/ind.roic;
  const tFcff=last.nopat*(1+a.terminalGrowth)*(1-reinvest);
  const tv=tFcff/(wacc-a.terminalGrowth);
  const pvExplicit=proj.reduce((s,r)=>s+r.pv,0);
  const pvTerminal=tv/Math.pow(1+wacc,proj.length-0.5);
  const ev=pvExplicit+pvTerminal;
  const tvShare=pvTerminal/ev;
  if(tvShare>0.75) flags.push(`${(tvShare*100).toFixed(0)}% of enterprise value sits beyond year ten. The projection is doing very little of the work — treat the terminal assumptions as the valuation.`);
  if(reinvest>1) flags.push("Terminal growth exceeds what the industry's return on capital can fund. Either growth is too high or the return assumption is too low.");

  const netDebt=co.debt-co.cash;
  const equity=ev-netDebt-co.minorityInterest+co.surplusAssets;
  if(equity<=0) flags.push("Equity value is nil or negative: net debt exceeds enterprise value.");
  const adj=equity*(1-a.dlom)*(1-a.dloc);
  const baseEbitda=co.baseRevenue*co.baseEbitdaMargin;

  return {w,wacc,proj,pvExplicit,pvTerminal,ev,netDebt,equity,adj,tvShare,reinvest,
          perShare: co.shares? adj*100/co.shares : null,   // ₹ cr -> ₹ per share (shares in lakh)
          impliedMult: baseEbitda>0? ev/baseEbitda : NaN, flags};
}

